PORT=8080
# Set to "empty" to disconnect record storage while retaining automation editors.
# Clear this value when ready to connect the database.
CRM_DATA_MODE=
NODE_ENV=production
BUSINESS_TIME_ZONE=America/Denver

# Business account registry. The service fails closed if more than one account is
# configured before DB isolation, memberships, and per-tenant provider credentials exist.
DEFAULT_TENANT_ID=opek
DEFAULT_TENANT_NAME=Opek Junk Removal
DEFAULT_TENANT_SHORT_NAME=Opek
DEFAULT_TENANT_CLERK_ORGANIZATION_ID=
DEFAULT_TENANT_CLERK_ORGANIZATION_SLUG=
# Add accounts as a JSON array, for example:
# TENANT_ACCOUNTS_JSON=[{"id":"acme","name":"Acme Services","shortName":"Acme","timeZone":"America/Denver","phoneNumbers":["+15551234567"],"clerkOrganizationId":"org_..."}]
TENANT_ACCOUNTS_JSON=[]

# Platform-admin business/Twilio provisioning (registration is deferred).
# Apply supabase/migrations/20260916_sms_business_accounts.sql before enabling.
# Keep disabled until the deployed webhook hostname is restored.
TENANT_REGISTRY_STORE=disabled
PLATFORM_ADMIN_USER_IDS=
# Store a base64-encoded, random 32-byte key in your deployment secret manager.
# Retain this key: losing/changing it without re-encryption makes tenant secrets unreadable.
TENANT_CREDENTIAL_ENCRYPTION_KEY=
# Explicit parent-account credentials; never expose these to business users.
TWILIO_PARENT_ACCOUNT_SID=
TWILIO_PARENT_AUTH_TOKEN=

# Clerk CRM authentication. Keep the secret key server-side.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional for a custom Clerk Frontend API domain used by the CSP.
# CLERK_FRONTEND_API_URL=https://clerk.example.com

# Local development adapter. Production should use "supabase" after applying the migration.
AUTOMATION_RULES_STORE=file
AUTOMATION_RULES_FILE=./data/automation-groups.json
AUTOMATION_AI_SETTINGS_FILE=./data/automation-ai-instructions.json

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=+18777574365

# Production always enforces webhook validation even if this is accidentally set false.
TWILIO_VALIDATE_SIGNATURE=true
PUBLIC_BASE_URL=http://localhost:8080

# WPacquisition Supabase (project wxamwhfmelxqahkdtcci) — server credential for CRM storage
SUPABASE_URL=https://wxamwhfmelxqahkdtcci.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge worker deployment (see docs/WORKER_DEPLOYMENT.md)
SUPABASE_PUBLISHABLE_KEY=
MIGRATION_DATABASE_URL=
SMS_API_DATABASE_URL=
SMS_WEBHOOK_DATABASE_URL=
WORKER_DATABASE_URL=
SMS_SENDER_DATABASE_URL=
SMS_AUTOMATION_DATABASE_URL=
SMS_AI_DATABASE_URL=
SMS_WORKER_SECRET=
AUTOMATION_WORKER_SECRET=
AI_WORKER_SECRET=
PROVISIONING_WORKER_SECRET=
KNOWLEDGE_WORKER_SECRET=
EMBEDDING_WORKER_SECRET=
HANDOFF_WORKER_SECRET=
COMPLIANCE_WORKER_SECRET=
CRM_ADMIN_CLERK_USER_ID=
CLERK_ISSUER=
CRM_ALLOWED_ORIGINS=https://wpacquisition-crm.onrender.com,http://127.0.0.1:8080,http://localhost:8080
CRM_API_BASE=https://wxamwhfmelxqahkdtcci.supabase.co/functions/v1/crm-api
SMS_WEBHOOK_BASE_URL=https://wxamwhfmelxqahkdtcci.supabase.co/functions/v1/twilio-webhook
SMS_CALLBACK_URL=https://wxamwhfmelxqahkdtcci.supabase.co/functions/v1/twilio-webhook/status
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini-2026-03-17
# Form Builder Node service (npm run start:forms). Never put these secrets in SMS_CONFIG.
# A dedicated database login granted only the sms_forms role.
FORMS_DATABASE_URL=
FORMS_PUBLIC_BASE_URL=
FORMS_SIGNING_SECRET=
FORM_BUILDER_MODEL=gpt-6-astra
FORMS_TURNSTILE_SITE_KEY=
FORMS_TURNSTILE_SECRET=
# Set to the actual number of trusted reverse proxies; 0 for a direct local server.
FORMS_TRUST_PROXY_HOPS=0
# Frontend build-time URL: the forms service origin, without /api/forms.
FORMS_API_BASE=
EMBEDDING_MODEL=text-embedding-3-small
# Optional estimates for the per-tenant operations dashboard. Set these from
# the current provider price sheet; leaving any value blank reports usage only.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
EMBEDDING_USD_PER_MILLION=
SMS_ESTIMATED_USD_PER_SEGMENT=

# Optional: website reader for the Business context form (same Firecrawl
# usage as the Get Started site-read). Without it the app parses the
# homepage HTML directly, which works for most static sites.
FIRECRAWL_API_KEY=

# ElevenLabs outbound follow-up calls (voice +18313187139)
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_OUTBOUND_AGENT_ID=agent_7801kwfn9rkcey5rn1wsrjdpnvvn
ELEVENLABS_AGENT_PHONE_NUMBER_ID=phnum_1601ktscp7y1e27b3apd0swmz55j
