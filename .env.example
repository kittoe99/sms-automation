PORT=8080
NODE_ENV=production

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=+18777574365

# Optional: validate Twilio webhook signatures in production
TWILIO_VALIDATE_SIGNATURE=false
PUBLIC_BASE_URL=http://localhost:8080

# Opek Supabase (project mjgwoukwyqwoectxfwqv) — service role for contact directory
SUPABASE_URL=https://mjgwoukwyqwoectxfwqv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for server-to-server sends (Opek-main edge function → POST /api/send)
OPEK_SMS_API_KEY=

# DigitalOcean Gradient™ AI agent (conversation runtime).
# App Platform handles Twilio webhooks + eligibility; Supabase is data-only.
AI_ENABLED=true
GRADIENT_AGENT_ENDPOINT=https://YOUR_AGENT.agents.do-ai.run
GRADIENT_AGENT_ACCESS_KEY=
GRADIENT_AGENT_UUID=
GRADIENT_AGENT_MODEL=mistral-3-14B
AI_ENABLED_CATEGORIES=quote-requests,appointment-reminders
AI_MAX_HISTORY=20
AI_MAX_REPLY_CHARS=320
