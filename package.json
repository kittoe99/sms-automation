{
  "name": "opek-sms",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-business SMS CRM with Supabase queues and bounded Edge workers",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:forms": "node src/formsServer.js",
    "preview:forms": "node scripts/preview-forms.js",
    "preview:forms:synthetic": "node scripts/preview-forms-synthetic.js",
    "dev": "node --watch src/index.js",
    "demo": "node src/demo.js",
    "test": "node --test \"test/*.test.js\"",
    "automation-tick": "node scripts/automation-tick.js",
    "voice-sync": "node scripts/voice-sync.js",
    "worker:sms": "node src/workers/run.js sms",
    "worker:automation": "node src/workers/run.js automation",
    "worker:ai": "node src/workers/run.js ai",
    "build:frontend": "node scripts/build-frontend.js",
    "db:assemble": "node scripts/assemble-migration.js",
    "test:workers": "node --test test/workerArchitecture.test.js test/edgeWorkers.test.js"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@clerk/express": "2.1.67",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supabase/supabase-js": "2.111.0",
    "@twilio/twilio-compliance-embed": "2.1.3",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "jose": "6.2.12",
    "openai": "7.20.0",
    "postgres": "3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "twilio": "5.5.1",
    "ws": "8.21.1",
    "zod": "3.25.76"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.28.2"
  }
}
